# fixtures or places. Fixtures are the default. Restart Expo after changing this.
CATALOG_SOURCE=fixtures

# Seed-only Places key for npm run seed:places. It stays off the device.
GOOGLE_PLACES_API_KEY=

# Read by the app through app.config.ts for the live ATL board and gate lookups (demo only; a public build needs a proxy).
# npm run seed:departures also uses it to refresh the bundled offline snapshot.
SKYLINK_API_KEY=

# Courier map. Enable "Maps SDK for iOS" and "Maps SDK for Android" for this key (not the Places key).
# The config plugin bakes it into the native build, so rebuild the dev client after changing it.
# Without it, iOS shows Apple Maps and Android shows a summary card.
GOOGLE_MAPS_API_KEY=

# Restaurant cover photos (Places API (New) only). A different key from GOOGLE_PLACES_API_KEY.
# Restrict it to iOS bundle ID com.f2delivers.wingsnack; the app sends that ID on every platform.
# Without it, restaurants show their initials and menus keep the colored cover.
GOOGLE_PLACES_CLIENT_KEY=

